<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>WeatherRecord</AssemblyName><PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained><EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup><EmbeddedResource Include="../web/*" LogicalName="web/%(Filename)%(Extension)" /></ItemGroup>
</Project>
